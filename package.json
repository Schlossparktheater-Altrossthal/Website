{
  "name": "theater-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:setup": "node scripts/setup-dev.mjs setup",
    "dev:setup:local": "node scripts/setup-dev.mjs setup --local",
    "dev:setup:hybrid": "node scripts/setup-dev.mjs setup --hybrid",
    "dev:start": "node scripts/setup-dev.mjs start",
    "dev:start:local": "node scripts/setup-dev.mjs start --local",
    "dev:start:hybrid": "node scripts/setup-dev.mjs start --hybrid",
    "dev:start:prod": "node scripts/setup-dev.mjs start --prod",
    "dev:services": "node scripts/setup-dev.mjs services",
    "dev:services:down": "node scripts/setup-dev.mjs services:down",
    "dev:reset": "node scripts/setup-dev.mjs reset",
    "dev:clean": "node scripts/setup-dev.mjs clean",
    "predev": "pnpm run workbox:copy-lib && node --env-file=.env scripts/run-prisma-migrate.mjs",
    "dev": "next dev --turbopack",
    "prebuild": "pnpm prisma:generate && pnpm run workbox:copy-lib",
    "build": "next build",
    "prestart": "node scripts/run-prisma-migrate.mjs",
    "postinstall": "node -e \"if(!process.env.SKIP_PRISMA_POSTINSTALL){require('child_process').execSync('pnpm prisma:generate',{stdio:'inherit'})}\"",
    "start": "next start",
    "start:combined": "node scripts/start-combined-server.mjs",
    "start:proxy": "node scripts/start-with-proxy.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.mjs",
    "swatches:gen": "node scripts/generate-swatches.mjs --json docs/swatches/palette.sample.json --out docs/swatches --size 14 --adoc docs/swatches/generated.adoc",
    "design-system:tokens": "node scripts/build-design-tokens.mjs",
    "workbox:copy-lib": "pnpm exec workbox copyLibraries public/workbox"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@sendgrid/mail": "^8.1.6",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-table": "^8.21.3",
    "@types/d3-cloud": "^1.2.9",
    "@zxing/browser": "^0.2.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-cloud": "^1.2.7",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "date-fns": "^4.1.0",
    "dexie": "4.4.2",
    "dexie-observable": "4.0.1-beta.13",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.23.22",
    "geist": "^1.5.1",
    "http-proxy": "^1.18.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^4.24.11",
    "node-ical": "^0.26.1",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-easy-crop": "^5.5.3",
    "react-hook-form": "^7.62.0",
    "react-quill-new": "^3.6.0",
    "recharts": "^3.2.1",
    "sanitize-html": "^2.13.0",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tippy.js": "^6.3.7",
    "workbox-background-sync": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0",
    "workbox-window": "^7.1.0",
    "zod": "^4.1.8",
