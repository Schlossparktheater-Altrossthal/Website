/// Onboarding einer Person für eine Produktion. Das MemberOnboardingProfile bleibt der
/// aktuelle Stand (Vorausfüllen), hier stehen die Angaben, die für diese Produktion galten.
model ProductionOnboarding {
  id                    String          @id @default(cuid())
  userId                String
  showId                String
  inviteId              String?
  redemptionId          String?         @unique
  focus                 OnboardingFocus
  /// Bestätigte Profildaten zum Zeitpunkt des Onboardings (Ernährung, Allergien, Rollenwünsche …).
