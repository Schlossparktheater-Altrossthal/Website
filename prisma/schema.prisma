/// Web-Push-Abo eines Geräts (Browser/installierte App).
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  /// Kurzname für die Geräteliste, z. B. „iPhone“ oder „Chrome (Windows)“
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Kanalwahl je Kategorie (proben | termine | gewerke | produktion | system). Ohne Eintrag gelten
/// die Standardwerte aus `src/lib/notifications/preferences.ts`.
model NotificationPreference {
  userId   String
  category String
  push     Boolean
  email    Boolean @default(false)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

/// Allgemeine Benachrichtigungs-Einstellungen, z. B. Ruhezeit für Push (Minuten ab Mitternacht,
/// Europe/Berlin; Ende kleiner als Beginn = über Mitternacht). Dringendes kommt trotzdem.
model NotificationSettings {
  userId       String  @id
  quietStart   Int?
  quietEnd     Int?
  /// Vorlaufzeit für Termin-Erinnerungen: `never` | `1h` | `2h` | `12h` | `1d` | `2d` | `3d` | `7d`.
  /// Ohne Eintrag gilt `DEFAULT_REMINDER_LEAD` aus `src/lib/notifications/preferences.ts`.
  reminderLead String?
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
