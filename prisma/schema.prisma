  /// Seitenwechsel: Dauer der Server-Anfrage (RSC) inkl. Netz, Rest ist Browser-Rendering
  serverMs           Int?
  /// Seitenwechsel: Anzahl der Server-Anfragen (inkl. Vorab-Laden) während des Wechsels
  requestCount       Int?
  ttfbMs             Int?
  fcpMs              Int?
  lcpMs              Int?
  inpMs              Int?
  cls                Float?
  deviceType         String
  browser            String
  browserVersion     String?
  os                 String
  userAgent          String?
  effectiveType      String?
  standalone         Boolean  @default(false)
  analyticsSessionId String?

  @@index([createdAt])
  @@index([route, kind])
  @@map("analytics_performance_samples")
}

/// Fehler aus Server-Rendering (onRequestError) und Browser (JS-Fehler), eine Zeile pro Vorkommen.
model AnalyticsErrorEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  /// "server" oder "client"
  source    String
  route     String
  message   String
  /// Kurzer Stack-Ausschnitt bzw. Next.js-Digest zur Wiedererkennung
  detail    String?
  browser   String?
  os        String?
  userId    String?

  @@index([createdAt])
  @@index([route])
  @@map("analytics_error_events")
}

model AnalyticsDeviceSnapshot {
  id                      String   @id @default(cuid())
  sessionId               String?  @unique
  deviceHint              String?
  userAgent               String?
  platform                String?
  hardwareConcurrency     Int?
  deviceMemoryGb          Float?
  touchSupport            Int?
  reducedMotion           Boolean?
  prefersDarkMode         Boolean?
  colorScheme             String?
  connectionType          String?
  connectionEffectiveType String?
  connectionRttMs         Float?
  connectionDownlinkMbps  Float?
  viewportWidth           Int?
  viewportHeight          Int?
  pixelRatio              Float?
  language                String?
  timezone                String?
  createdAt               DateTime @default(now())

  @@index([deviceHint])
  @@index([createdAt])
}

model AnalyticsPageMetric {
  id                   String   @id @default(cuid())
  path                 String
  scope                String?
  avgLoadMs            Float    @map("avg_load")
  lcpMs                Float?   @map("lcp")
  avgTimeOnPageSeconds Float?   @map("avg_time_on_page")
  weight               Int      @default(0)
  generatedAt          DateTime @default(now())

  @@index([path])
  @@index([scope])
  @@map("analytics_page_metrics")
}

model AnalyticsDeviceMetric {
  id          String   @id @default(cuid())
  device      String
  sessions    Int
  avgLoadMs   Float    @map("avg_load")
  share       Float
  generatedAt DateTime @default(now())

  @@index([device])
  @@map("analytics_device_metrics")
}

model AnalyticsSession {
  id                 String                        @id
  userId             String?
  membershipRole     String?
  isMember           Boolean                       @default(false)
  startedAt          DateTime                      @default(now())
  lastSeenAt         DateTime                      @default(now())
  endedAt            DateTime?
  durationSeconds    Int?
  pagePaths          String[]                      @default([])
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  pageViews          AnalyticsPageView[]
  trafficAttribution AnalyticsTrafficAttribution[]

  @@index([userId])
  @@index([lastSeenAt])
}

model AnalyticsTrafficAttribution {
  id                 String            @id @default(cuid())
  sessionId          String            @unique
  analyticsSessionId String?
  path               String
  referrer           String?
  referrerDomain     String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmTerm            String?
  utmContent         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  analyticsSession   AnalyticsSession? @relation(fields: [analyticsSessionId], references: [id], onDelete: SetNull)

  @@index([analyticsSessionId])
  @@index([path])
  @@index([referrerDomain])
  @@index([utmSource])
  @@index([utmMedium])
}

model AnalyticsRealtimeEvent {
  id         String   @id @default(cuid())
  eventType  String
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([occurredAt])
  @@index([eventType, occurredAt])
}

model AnalyticsSessionInsight {
  id                        String   @id @default(cuid())
  segment                   String
  avgSessionDurationSeconds Float
  pagesPerSession           Float
  retentionRate             Float
  share                     Float
  conversionRate            Float
  generatedAt               DateTime @default(now())

  @@index([segment])
  @@map("analytics_session_insights")
}

model AnalyticsTrafficSource {
  id                        String   @id @default(cuid())
  channel                   String
  sessions                  Int
  avgSessionDurationSeconds Float
  conversionRate            Float
  changePercent             Float
  generatedAt               DateTime @default(now())

  @@index([channel])
  @@map("analytics_traffic_sources")
}

model Ticket {
  id         String       @id @default(cuid())
  code       String       @unique
  eventId    String
  holderName String?
  status     TicketStatus @default(unused)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  scanEvents TicketScanEvent[]

  @@index([eventId])
}

model TicketScanEvent {
  id               String       @id @default(cuid())
  ticketId         String
  code             String
  statusBefore     TicketStatus
  statusAfter      TicketStatus
  source           String?
  occurredAt       DateTime
  dedupeKey        String?      @unique
  serverSeq        Int?
  processedAt      DateTime?
  provisional      Boolean      @default(false)
  clientId         String?
  clientMutationId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, occurredAt])
}

model AnalyticsRealtimeSummary {
  id          String   @id @default(cuid())
  windowStart DateTime
  windowEnd   DateTime
  totalEvents Int
  eventCounts Json?
  generatedAt DateTime @default(now())

  @@index([windowEnd])
  @@map("analytics_realtime_summary")
}

model AnalyticsSessionSummary {
  id                               String   @id @default(cuid())
  windowStart                      DateTime
  windowEnd                        DateTime
  peakConcurrentUsers              Int      @default(0)
  membersRealtimeEvents            Int      @default(0)
  membersAvgSessionDurationSeconds Float    @default(0)
  guestAvgSessionDurationSeconds   Float    @default(0)
  generatedAt                      DateTime @default(now())

  @@index([windowEnd])
  @@map("analytics_session_summary")
}

model AnalyticsServerLog {
  id                String                     @id @default(cuid())
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  severity          AnalyticsServerLogSeverity
  service           String
  message           String
  description       String?
  metadata          Json?
  tags              String[]                   @default([])
  status            AnalyticsServerLogStatus   @default(open)
  occurrences       Int                        @default(1)
  affectedUsers     Int?
  recommendedAction String?
  firstSeenAt       DateTime                   @default(now())
  lastSeenAt        DateTime                   @default(now())
  fingerprint       String                     @unique

  @@index([severity, lastSeenAt])
  @@index([status, lastSeenAt])
  @@map("analytics_server_logs")
}

/// Protokoll der Datenportal-Abfragen und -Exporte (nur Metadaten, keine Ergebniswerte).
/// Wird nach DATA_PORTAL_AUDIT_RETENTION_MONTHS automatisch gelöscht.
model DataPortalAuditLog {
  id        String   @id @default(cuid())
  userId    String
  showId    String?
  action    String
  source    String
  fields    String[] @default([])
  rowCount  Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Art eines Ausstattungsstücks (docs/Plan/ausstattung-plan.md).
enum ProductionObjectKind {
  prop
  set_piece
  costume
  costume_part
  other
}

/// Woher ein Ausstattungsstück kommt.
enum ProductionObjectSource {
  undecided
  stock
  build
  buy
  borrow
}

enum ProductionObjectStatus {
  planned
  in_progress
  ready
}

enum SceneRequirementStatus {
  open
  assigned
  declined
}

/// Ausstattungsstück einer Produktion: Requisite, Bühnenbild-Element, Kostüm oder Kostümteil.
/// Ein Objekt hängt an beliebig vielen Szenen und hat genau eine Karte im Board des zuständigen Gewerks.
model ProductionObject {
  id                 String                  @id @default(cuid())
  showId             String
  departmentId       String
  kind               ProductionObjectKind    @default(prop)
  title              String
  /// Ausführliche Beschreibung (Markdown).
  description        String?
  source             ProductionObjectSource  @default(undecided)
  status             ProductionObjectStatus  @default(planned)
  dimensions         String?
  material           String?
  /// Geschätzte Kosten; tatsächliche Ausgaben über `FinanceEntry.objectId`.
  costCents          Int?
  note               String?
  /// Bei Herkunft Fundus: Lager-Typ oder -Exemplar.
  inventoryProductId String?
  inventoryAssetId   String?
  /// Vorstellungs-Check (Requisiten): zuletzt abgehakt.
  checkedAt          DateTime?
  checkedById        String?
  archivedAt         DateTime?
  createdById        String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  show               Show                    @relation(fields: [showId], references: [id], onDelete: Cascade)
  department         Department              @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  inventoryProduct   InventoryProduct?       @relation(fields: [inventoryProductId], references: [id], onDelete: SetNull)
  inventoryAsset     InventoryAsset?         @relation(fields: [inventoryAssetId], references: [id], onDelete: SetNull)
  createdBy          User?                   @relation("ProductionObjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  checkedBy          User?                   @relation("ProductionObjectChecker", fields: [checkedById], references: [id], onDelete: SetNull)
  photos             ProductionObjectPhoto[]
  scenes             ObjectScene[]
  characters         ObjectCharacter[]
  /// Kostüm: zugehörige Teile.
  parts              CostumePart[]           @relation("CostumeParts")
  /// Kostümteil: Kostüme, in denen es vorkommt.
  partOf             CostumePart[]           @relation("CostumePartOf")
  task               DepartmentTask?
  activities         TaskActivity[]
  requirements       SceneRequirement[]
  financeEntries     FinanceEntry[]

  @@index([showId, kind])
  @@index([departmentId])
}

model ProductionObjectPhoto {
  id        String           @id @default(cuid())
  objectId  String
  data      Bytes
  mimeType  String
  /// `reference` = Vorbild/Skizze, `actual` = wie es wirklich aussieht.
  kind      String           @default("reference")
  caption   String?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  object    ProductionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@index([objectId])
}

/// Objekt in einer Szene; `note` z. B. Position („Tisch links“) oder „bleibt stehen“.
model ObjectScene {
  id       String           @id @default(cuid())
  objectId String
  sceneId  String
  note     String?
  object   ProductionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  scene    Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([objectId, sceneId])
  @@index([sceneId])
}

/// Objekt einer Rolle (Requisite in der Hand, Kostüm der Rolle).
model ObjectCharacter {
  id          String           @id @default(cuid())
  objectId    String
  characterId String
  object      ProductionObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  character   Character        @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([objectId, characterId])
  @@index([characterId])
}

/// Kostüm = Zusammenstellung aus Teilen; ein Teil kann in mehreren Kostümen vorkommen.
model CostumePart {
  id        String           @id @default(cuid())
  costumeId String
  partId    String
  position  Int              @default(0)
  costume   ProductionObject @relation("CostumeParts", fields: [costumeId], references: [id], onDelete: Cascade)
  part      ProductionObject @relation("CostumePartOf", fields: [partId], references: [id], onDelete: Cascade)

  @@unique([costumeId, partId])
  @@index([partId])
}

/// Anforderung aus einer Szene (Regie/Planung); das Gewerk entscheidet im Eingang.
model SceneRequirement {
  id            String                 @id @default(cuid())
  showId        String
  sceneId       String
  departmentId  String
  kind          ProductionObjectKind   @default(prop)
  characterId   String?
  text          String
  photo         Bytes?
  photoMimeType String?
  status        SceneRequirementStatus @default(open)
  declineReason String?
  objectId      String?
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  show          Show                   @relation(fields: [showId], references: [id], onDelete: Cascade)
  scene         Scene                  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  department    Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  character     Character?             @relation(fields: [characterId], references: [id], onDelete: SetNull)
  object        ProductionObject?      @relation(fields: [objectId], references: [id], onDelete: SetNull)
  requestedBy   User?                  @relation("SceneRequirementRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy     User?                  @relation("SceneRequirementDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([departmentId, status])
  @@index([sceneId])
}

/// Checkliste einer Karte (Fertigungsschritte).
model TaskChecklistItem {
  id       String         @id @default(cuid())
  taskId   String
  text     String
  doneAt   DateTime?
  doneById String?
  position Int            @default(0)
  task     DepartmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneBy   User?          @relation("ChecklistItemDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([taskId, position])
}

/// Verlauf einer Karte bzw. eines Ausstattungsstücks (docs/Plan/uebergabe-plan.md).
model TaskActivity {
  id           String            @id @default(cuid())
  departmentId String
  taskId       String?
  objectId     String?
  actorId      String?
  type         TaskActivityType
  /// Typabhängig, z. B. `{ text }`, `{ from, to }`.
  data         Json?
  createdAt    DateTime          @default(now())
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  task         DepartmentTask?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  object       ProductionObject? @relation(fields: [objectId], references: [id], onDelete: Cascade)
  actor        User?             @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([departmentId, createdAt])
  @@index([taskId, createdAt])
  @@index([objectId, createdAt])
}

/// Angepinnter Hinweis für das ganze Gewerk, bis jemand ihn erledigt.
model DepartmentNotice {
  id           String     @id @default(cuid())
  departmentId String
  body         String
  authorId     String?
  createdAt    DateTime   @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author       User?      @relation("DepartmentNoticeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  resolvedBy   User?      @relation("DepartmentNoticeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([departmentId, resolvedAt])
}

/// „Feierabend“: Zusammenfassung der eigenen Arbeit für die Nächsten.
model DepartmentHandover {
  id           String     @id @default(cuid())
  departmentId String
  authorId     String?
  /// Automatisch: `{ taskId, title, lines[] }[]`.
  summary      Json
  note         String?
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  author       User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([departmentId, createdAt])
}

/// Letzter Besuch einer Person im Gewerk, für „Seit deinem letzten Besuch“.
model DepartmentVisit {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  /// Zuletzt gesehen (laufender Besuch).
  lastSeenAt   DateTime
  /// Bezugspunkt für „neu“: Ende des vorigen Besuchs.
  previousAt   DateTime?
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
}
