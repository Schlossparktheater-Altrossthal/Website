model Notification {
  id         String                  @id @default(cuid())
  title      String
  body       String?
  type       String?
  createdAt  DateTime                @default(now())
  eventId    String?
  event      CalendarEvent?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
